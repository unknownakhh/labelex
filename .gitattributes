# Normalise line endings: store LF in the repo for all text files,
# regardless of whether they were edited on Windows (CRLF) or Mac/Linux (LF).
# This stops the "LF will be replaced by CRLF" warnings and keeps diffs clean.
* text=auto eol=lf

# Explicit web text types
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
_redirects  text eol=lf

# Binary assets — never touch these
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary
*.gif   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
